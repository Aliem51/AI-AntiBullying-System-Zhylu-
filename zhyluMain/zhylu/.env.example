# Google Gemini API (для ИИ-анализа жалоб)
# Получить бесплатный ключ: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (для аутентификации администраторов)
# Создать проект: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Node/Express сервер (загрузка файлов)
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
PORT=5000

# Telegram уведомления (опционально)
TG_BOT_TOKEN=YOUR_TELEGRAM_TOKEN_HERE
TG_CHAT_ID=YOUR_CHAT_ID_HERE
